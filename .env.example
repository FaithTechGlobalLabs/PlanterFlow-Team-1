# Copy to .env.local and fill in from the Supabase dashboard (Project Settings > API).
# .env.local is gitignored. Never commit real keys.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-key

# Preferred instead of the legacy anon key above. A publishable key is browser-safe.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only. Used by route handlers for invitations, seeding, and PDF export.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Alternatively use SUPABASE_SECRET_KEY with a modern sb_secret_ key. Server only.
